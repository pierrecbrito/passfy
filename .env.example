# Database
POSTGRES_USER=passfy_user
POSTGRES_PASSWORD=passfy_password
POSTGRES_DB=passfy_db
DATABASE_URL="postgresql://passfy_user:passfy_password@localhost:5432/passfy_db?schema=public"

# API & Security
PORT=3333
NODE_ENV=development
JWT_SECRET=super_secret_passfy_jwt_key_development_only_change_in_production
QR_SECRET_KEY=passfy_cryptographic_qr_signing_key_hmac_sha256_secret
CORS_ORIGIN=http://localhost:5173

# External APIs & AI
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2

# Google Gemini AI (100% Gratuito via aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

