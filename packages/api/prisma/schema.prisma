generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ORGANIZER
  CUSTOMER
  GATEKEEPER
}

enum EventCategory {
  MOVIE
  CONCERT
  THEATER
  OTHER
}

enum EventType {
  SEATED
  GENERAL_ADMISSION
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  ISSUED
  USED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizedEvents   Event[]
  reservations      Reservation[]
  tickets           Ticket[]
  validatedTickets  Ticket[]      @relation("GatekeeperTickets")

  @@map("users")
}

model Event {
  id             String        @id @default(uuid())
  title          String
  description    String        @db.Text
  category       EventCategory @default(MOVIE)
  type           EventType     @default(SEATED)
  bannerUrl      String?
  venue          String
  date           DateTime
  price          Decimal       @db.Decimal(10, 2)
  capacity       Int
  ticketTiers    Json?
  externalId     String?
  externalSource String?
  organizerId    String
  organizer      User          @relation(fields: [organizerId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  seats        Seat[]
  reservations Reservation[]
  tickets      Ticket[]

  @@map("events")
}

model Seat {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row         String
  number      Int
  label       String
  isAvailable Boolean  @default(true)
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservationItems ReservationItem[]
  tickets          Ticket[]

  @@unique([eventId, row, number])
  @@map("seats")
}

model Reservation {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id])
  status      ReservationStatus @default(PENDING)
  totalAmount Decimal           @db.Decimal(10, 2)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items   ReservationItem[]
  tickets Ticket[]

  @@map("reservations")
}

model ReservationItem {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  seatId        String?
  seat          Seat?       @relation(fields: [seatId], references: [id])
  price         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@map("reservation_items")
}

model Ticket {
  id                 String       @id @default(uuid())
  ticketCode         String       @unique
  qrToken            String       @db.Text
  qrSignature        String
  shareToken         String       @unique
  status             TicketStatus @default(ISSUED)
  holderName         String?
  ticketType         String?      @default("INTEIRA")
  studentId          String?
  userId             String
  user               User         @relation(fields: [userId], references: [id])
  eventId            String
  event              Event        @relation(fields: [eventId], references: [id])
  seatId             String?
  seat               Seat?        @relation(fields: [seatId], references: [id])
  reservationId      String?
  reservation        Reservation? @relation(fields: [reservationId], references: [id])
  usedAt             DateTime?
  usedByGatekeeperId String?
  usedByGatekeeper   User?        @relation("GatekeeperTickets", fields: [usedByGatekeeperId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("tickets")
}
