{
  "name": "passfy",
  "version": "1.0.0",
  "private": true,
  "description": "Passfy - Plataforma de Gestão, Venda e Validação de Ingressos e Eventos",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:api": "npm run dev --workspace=@passfy/api",
    "dev:web": "npm run dev --workspace=@passfy/web",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=@passfy/api",
    "start": "npm run start --workspace=@passfy/api",
    "start:api": "npm run start --workspace=@passfy/api",
    "test": "npm run test --workspace=@passfy/api",
    "lint": "npm run lint --workspaces"
  },
  "dependencies": {
    "prisma": "^5.18.0",
    "typescript": "^5.5.4"
  },



  "keywords": [
    "tickets",
    "events",
    "monolith",
    "nodejs",
    "react",
    "typescript",
    "prisma",
    "postgresql"
  ],
  "author": "Pierre Brito",
  "license": "MIT"
}
